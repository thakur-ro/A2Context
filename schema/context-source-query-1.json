{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2Context context source query",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "workspace" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "organization_id"],
          "properties": { "kind": { "const": "organization" }, "organization_id": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "user_id"],
          "properties": {
            "kind": { "const": "user" },
            "organization_id": { "type": ["string", "null"] },
            "user_id": { "type": "string" }
          }
        }
      ]
    },
    "thread": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["trace_source", "conversation_id"],
      "properties": {
        "trace_source": { "type": "string" },
        "organization_id": { "type": ["string", "null"] },
        "user_id": { "type": ["string", "null"] },
        "conversation_id": { "type": "string" }
      }
    },
    "source_id": { "type": ["string", "null"], "description": "Exact named source. Omit to list profiles instead of occurrences." },
    "source_version": { "type": ["string", "null"], "description": "Optional exact recorded source version." },
    "search": { "type": ["string", "null"], "description": "Case-insensitive substring of the named source, recorded version, or trace source. A match in either scope retains both results." },
    "evidence_filter": {
      "enum": ["all", "conflicts", "measured", "unmeasured", "activation_swaps"],
      "default": "all",
      "description": "Filter occurrences in both scopes. Conflicts include verified preflight and scoped recorded decisions. Measured effects include usable zero results. Activation swaps require a decoder-block sweep at the captured source tokens."
    },
    "after": { "type": ["string", "null"], "format": "date-time", "description": "Inclusive recorded call start in RFC 3339." },
    "before": { "type": ["string", "null"], "format": "date-time", "description": "Exclusive recorded call start in RFC 3339." },
    "compare": {
      "type": ["object", "null"],
      "description": "Compare named source exposure in a second scope, conversation, or time window.",
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "#/properties/scope" },
        "thread": { "$ref": "#/properties/thread" },
        "after": { "$ref": "#/properties/after" },
        "before": { "$ref": "#/properties/before" }
      }
    },
    "offset": { "type": "integer", "minimum": 0, "default": 0 },
    "compare_offset": { "type": "integer", "minimum": 0, "default": 0, "description": "Occurrence page offset for the second scope when a source ID is selected." },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
  }
}
