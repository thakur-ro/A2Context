{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusWeave context source query",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "workspace" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "organization_id"],
          "properties": { "kind": { "const": "organization" }, "organization_id": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "user_id"],
          "properties": {
            "kind": { "const": "user" },
            "organization_id": { "type": ["string", "null"] },
            "user_id": { "type": "string" }
          }
        }
      ]
    },
    "thread": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["trace_source", "conversation_id"],
      "properties": {
        "trace_source": { "type": "string" },
        "organization_id": { "type": ["string", "null"] },
        "user_id": { "type": ["string", "null"] },
        "conversation_id": { "type": "string" }
      }
    },
    "source_id": { "type": ["string", "null"], "description": "Exact named source. Omit to list profiles instead of occurrences." },
    "source_version": { "type": ["string", "null"], "description": "Optional exact recorded source version." },
    "after": { "type": ["string", "null"], "format": "date-time", "description": "Inclusive recorded call start in RFC 3339." },
    "before": { "type": ["string", "null"], "format": "date-time", "description": "Exclusive recorded call start in RFC 3339." },
    "offset": { "type": "integer", "minimum": 0, "default": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
  }
}
