{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2Context candidate probe case",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "scorer_id", "candidates", "interventions"],
  "allOf": [{
    "if": { "required": ["test_pair"], "properties": { "test_pair": { "const": true } } },
    "then": { "properties": { "interventions": { "minItems": 2, "maxItems": 2 } } }
  }],
  "dependentSchemas": {
    "reference_target": { "required": ["assistant_prefix"], "properties": { "assistant_prefix": { "minLength": 1 } } }
  },
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "\\S" },
    "scorer_id": { "type": "string", "pattern": "\\S" },
    "test_pair": { "type":"boolean", "default":false },
    "assistant_prefix": { "type": "string", "default": "" },
    "reference_target": {
      "type": "object", "additionalProperties": false, "required": ["set", "candidate_id"],
      "properties": {
        "set": { "type": "string", "pattern": "\\S", "maxLength": 128 },
        "candidate_id": { "type": "string", "minLength": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "continuation"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "continuation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["context_id", "pointer", "replacement"],
        "properties": {
          "context_id": { "type": "string", "minLength": 1 },
          "pointer": { "type": "string", "pattern": "^/" },
          "operation": {
            "enum": ["replace_text", "replace_text_fragment", "replace_json", "remove_json"],
            "default": "replace_text"
          },
          "text_range": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["start_byte", "end_byte"],
            "properties": {
              "start_byte": { "type": "integer", "minimum": 0 },
              "end_byte": { "type": "integer", "minimum": 1 }
            }
          },
          "replacement": { "type": "string" }
        }
      }
    }
  }
}
