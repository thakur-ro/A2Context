{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusWeave candidate decoder-block probe",
  "description": "One post-block vector transplant at a time, read out as next-token log odds for the first tokens of the two candidates. Blocks and token positions use zero-based indices.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "model_id", "model_revision", "runtime", "tokenizer_sha256", "blocks", "choice_token_ids", "baseline", "self_swaps", "effects"],
  "properties": {
    "version": { "const": 1 },
    "model_id": { "type": "string", "pattern": "\\S" },
    "model_revision": { "type": "string", "pattern": "\\S" },
    "runtime": { "type": "string", "pattern": "\\S" },
    "tokenizer_sha256": { "$ref": "candidate-probe-report-1.json#/$defs/digest" },
    "blocks": { "type": "integer", "minimum": 2, "maximum": 256 },
    "choice_token_ids": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": { "$ref": "#/$defs/token_id" }
    },
    "baseline": { "$ref": "#/$defs/condition" },
    "self_swaps": { "$ref": "#/$defs/sweeps" },
    "effects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["condition_id", "donor", "swaps"],
        "properties": {
          "condition_id": { "type": "string" },
          "donor": { "$ref": "#/$defs/condition" },
          "swaps": { "$ref": "#/$defs/sweeps" }
        }
      }
    }
  },
  "$defs": {
    "token_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "position": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "token_id"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "token_id": { "$ref": "#/$defs/token_id" }
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["request_sha256", "rendered_prefix_sha256", "token_count", "positions", "margin"],
      "properties": {
        "request_sha256": { "$ref": "candidate-probe-report-1.json#/$defs/digest" },
        "rendered_prefix_sha256": { "$ref": "candidate-probe-report-1.json#/$defs/digest" },
        "token_count": { "type": "integer", "minimum": 2 },
        "margin": { "type": "number" },
        "positions": {
          "type": "object", "additionalProperties": false,
          "required": ["last_user_token", "last_prefix_token"],
          "properties": {
            "last_user_token": { "$ref": "#/$defs/position" },
            "last_prefix_token": { "$ref": "#/$defs/position" }
          }
        }
      }
    },
    "margins": {
      "type": "array", "minItems": 2, "maxItems": 256, "items": { "type": "number" }
    },
    "sweeps": {
      "type": "object", "additionalProperties": false,
      "required": ["last_user_token", "last_prefix_token"],
      "properties": {
        "last_user_token": { "$ref": "#/$defs/margins" },
        "last_prefix_token": { "$ref": "#/$defs/margins" }
      }
    }
  }
}
