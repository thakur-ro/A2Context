{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusWeave evidence v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/run"
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "source",
        "calls"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "organization_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/span" }
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          },
          "minItems": 1
        }
      }
    },
    "span": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "parent_span_id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"] }
      }
    },
    "call": {
      "type": "object",
      "required": [
        "id",
        "context",
        "decisions",
        "tool_results"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "span_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_request": {
          "type": ["object", "null"],
          "required": ["body", "evidence"],
          "properties": {
            "body": {
              "type": "string",
              "contentMediaType": "application/json",
              "contentSchema": { "type": "object" }
            },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        "ended_at": { "type": ["string", "null"] },
        "retrieval": {
          "type": ["object", "null"],
          "required": ["label", "documents"],
          "properties": {
            "label": { "type": "string" },
            "documents": { "type": "array", "items": { "$ref": "#/$defs/context" } }
          }
        },
        "context_metadata": {
          "type": ["object", "null"],
          "required": ["evidence"],
          "properties": {
            "evidence": { "$ref": "#/$defs/evidence" },
            "issue": { "type": ["string", "null"] }
          }
        },
        "preflight_receipt": {
          "type": ["object", "null"],
          "required": ["evidence"],
          "properties": {
            "evidence": { "$ref": "#/$defs/evidence" },
            "receipt": {
              "type": ["object", "null"],
              "required": ["version", "fingerprint"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "integer", "minimum": 0 },
                "scope": { "anyOf": [{ "$ref": "#/$defs/decision_scope" }, { "type": "null" }] },
                "fingerprint": { "type": "string" }
              }
            }
          }
        },
        "candidate_probes": {
          "type": ["object", "null"],
          "required": ["evidence"],
          "properties": {
            "evidence": { "$ref": "#/$defs/evidence" },
            "reports": {
              "type": ["array", "null"],
              "items": { "$ref": "candidate-probe-report-1.json" }
            }
          }
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "tool_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_result"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "availability",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_reference": { "type": ["string", "null"] },
        "request_fragment": {
          "type": ["object", "null"],
          "required": ["pointer", "text_range"],
          "additionalProperties": false,
          "properties": {
            "pointer": { "type": "string", "pattern": "^/" },
            "text_range": {
              "type": "object",
              "required": ["start_byte", "end_byte"],
              "additionalProperties": false,
              "properties": {
                "start_byte": { "type": "integer", "minimum": 0 },
                "end_byte": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "document_identity": {
          "type": ["object", "null"],
          "required": ["id", "evidence"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability": {
          "enum": [
            "included",
            "redacted",
            "unknown"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label",
        "outcome",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "outcome": {},
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "applies_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/decision_scope"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "key",
        "scope"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "value": {}
      }
    },
    "decision_scope": {
      "type": "object",
      "required": [
        "key",
        "scope"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "tool_result": {
      "type": "object",
      "required": [
        "tool_call_id",
        "evidence"
      ],
      "properties": {
        "tool_call_id": {
          "type": "string"
        },
        "outcome": {},
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["decision_id", "context_id", "relation", "basis"],
      "properties": {
        "decision_id": { "type": "string" },
        "context_id": { "type": "string" },
        "relation": { "type": "string" },
        "excerpt": { "type": ["string", "null"] },
        "basis": { "enum": ["observed", "declared", "derived", "hypothesis"] },
        "evidence": {
          "anyOf": [{ "$ref": "#/$defs/evidence" }, { "type": "null" }]
        }
      },
      "if": { "properties": { "basis": { "const": "observed" } }, "required": ["basis"] },
      "then": { "required": ["evidence"], "properties": { "evidence": { "$ref": "#/$defs/evidence" } } }
    },
    "evidence": {
      "type": "object",
      "required": [
        "field"
      ],
      "properties": {
        "span_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "type": "string"
        },
        "message_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "part_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
