{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusWeave source visibility report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "id", "location", "model_id", "model_revision", "runtime", "prompt_sha256", "tokenizer_sha256", "request_sha256", "prompt_token_count", "baseline_answer", "output_token_ids", "fragments", "baseline_log_probs", "all_visible_max_abs_error", "sources"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "source_visibility" },
    "id": { "$ref": "#/$defs/nonempty" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "call_id", "decision_id"],
      "properties": {
        "run_id": { "$ref": "#/$defs/nonempty" },
        "call_id": { "$ref": "#/$defs/nonempty" },
        "decision_id": { "$ref": "#/$defs/nonempty" }
      }
    },
    "model_id": { "$ref": "#/$defs/nonempty" },
    "model_revision": { "$ref": "#/$defs/nonempty" },
    "runtime": { "$ref": "#/$defs/nonempty" },
    "prompt_sha256": { "$ref": "#/$defs/digest" },
    "tokenizer_sha256": { "$ref": "#/$defs/digest" },
    "request_sha256": { "$ref": "#/$defs/digest", "description": "Digest of the exact UTF-8 recorded request body." },
    "prompt_token_count": { "type": "integer", "minimum": 2 },
    "baseline_answer": { "$ref": "#/$defs/nonempty", "description": "Exact generated output, including any tool proposal delimiters." },
    "baseline_tool_call": { "$ref": "#/$defs/tool_call", "description": "Required when measuring a recorded tool call." },
    "output_token_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
    "fragments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "baseline_log_probs": { "$ref": "#/$defs/log_probs" },
    "all_visible_max_abs_error": { "type": "number", "minimum": 0, "maximum": 0.00001 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per captured context item on the decision's call.",
      "items": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "$ref": "#/$defs/unavailable" }] }
    },
    "pairs": {
      "type": "array",
      "description": "Scores with two individually measured, non-overlapping sources masked together.",
      "items": { "$ref": "#/$defs/pair" }
    },
    "continuations": {
      "type": "array",
      "description": "Greedy continuations with an all-visible control and a measured source or pair masked throughout decoding.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context_ids", "start_output_token", "max_new_tokens", "clean", "masked"],
        "properties": {
          "context_ids": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
          "start_output_token": { "type": "integer", "minimum": 0 },
          "max_new_tokens": { "type": "integer", "minimum": 1 },
          "clean": { "$ref": "#/$defs/continuation" },
          "masked": { "$ref": "#/$defs/continuation" },
          "tool_call": { "$ref": "#/$defs/tool_call", "description": "The parsed masked proposal, when present. Argument schemas require separate validation." }
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "Optional workflow-defined names for intervals in the recorded output.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "token_range"],
        "properties": {
          "key": { "$ref": "#/$defs/nonempty", "description": "Stable key, unique within the report. Use a workflow-qualified name." },
          "token_range": {
            "description": "Zero-based start and exclusive end in the recorded output token sequence.",
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments"],
      "properties": { "name": { "$ref": "#/$defs/nonempty" }, "arguments": { "type": "object" } }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "token_ids", "stop_reason"],
      "properties": {
        "text": { "type": "string" },
        "token_ids": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
        "stop_reason": { "enum": ["end_of_sequence", "token_limit"] }
      }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "log_probs": { "type": "array", "minItems": 1, "items": { "type": "number", "maximum": 0 } },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "captured_text_sha256", "token_range", "masked_log_probs"],
      "properties": {
        "context_id": { "$ref": "#/$defs/nonempty" },
        "captured_text_sha256": { "$ref": "#/$defs/digest" },
        "request_pointer": {
          "type": "string",
          "pattern": "^/",
          "description": "JSON Pointer to the exact request object or array captured by this source. Use the context item's request fragment for text spans."
        },
        "boundary_whitespace": {
          "type": "object",
          "description": "Exact ASCII whitespace outside the captured source that shares its first or last prompt token. Omit for an exact span.",
          "required": ["before", "after"],
          "additionalProperties": false,
          "properties": {
            "before": { "type": "string", "pattern": "^[ \\t\\r\\n]*$" },
            "after": { "type": "string", "pattern": "^[ \\t\\r\\n]*$" }
          },
          "anyOf": [
            { "properties": { "before": { "minLength": 1 } } },
            { "properties": { "after": { "minLength": 1 } } }
          ]
        },
        "token_range": {
          "description": "Zero-based start and exclusive end in the rendered prompt.",
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        },
        "masked_log_probs": { "$ref": "#/$defs/log_probs" }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_ids", "masked_log_probs"],
      "properties": {
        "context_ids": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "masked_log_probs": { "$ref": "#/$defs/log_probs" }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "unavailable"],
      "properties": {
        "context_id": { "$ref": "#/$defs/nonempty" },
        "unavailable": {
          "enum": ["text_not_captured", "no_request_fragment", "unsupported_request_field", "request_object_not_found", "request_object_ambiguous", "rendered_source_unaligned", "token_boundary_unaligned"]
        }
      }
    }
  }
}
