{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusWeave visibility pattern query",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "output_token"],
  "properties": {
    "version": { "const": 1 },
    "output_token": { "type": "integer", "minimum": 0, "description": "Zero-based output token position to compare." },
    "kind": { "enum": ["source", "pair"], "default": "source" },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "workspace" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "organization_id"],
          "properties": {
            "kind": { "const": "organization" },
            "organization_id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "user_id"],
          "properties": {
            "kind": { "const": "user" },
            "organization_id": { "type": ["string", "null"] },
            "user_id": { "type": "string" }
          }
        }
      ]
    },
    "thread": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["trace_source", "conversation_id"],
      "properties": {
        "trace_source": { "type": "string" },
        "organization_id": { "type": ["string", "null"] },
        "user_id": { "type": ["string", "null"] },
        "conversation_id": { "type": "string" }
      }
    },
    "source_id": { "type": ["string", "null"], "description": "Match a declared stable source ID, including either member of a pair." },
    "after": { "type": ["string", "null"], "format": "date-time", "description": "Inclusive call start in RFC 3339." },
    "before": { "type": ["string", "null"], "format": "date-time", "description": "Exclusive call start in RFC 3339." },
    "min_conversations": { "type": ["integer", "null"], "minimum": 0, "description": "Require at least this many identified conversations in each group." },
    "group": { "type": ["string", "null"], "description": "Copy a key from a groups page to read its contributing turns." },
    "offset": { "type": "integer", "minimum": 0, "default": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
  }
}
