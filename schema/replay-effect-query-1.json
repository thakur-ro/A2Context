{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusWeave controlled replay effect query",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "selection": { "$ref": "#/$defs/selection" },
    "compare": { "anyOf": [{ "$ref": "#/$defs/selection" }, { "type": "null" }] },
    "source_id": { "type": ["string", "null"], "description": "Match the exact declared ID of any source edited in the comparison." },
    "kind": { "enum": ["single", "pair", "control", null], "description": "Select an individual edit, joint edit, or target versus negative control comparison." },
    "min_conversations": { "type": "integer", "minimum": 0, "default": 0, "description": "Minimum identified conversations with a usable effect on either selected side." },
    "group": { "type": ["string", "null"], "description": "Copy an exact comparison key from the groups response with the same filters." },
    "include_excerpts": { "type": "boolean", "default": false, "description": "Include bounded replacement text when enabled by the MCP host. Other captured text and trial outcomes are omitted." },
    "offset": { "type": "integer", "minimum": 0, "default": 0 },
    "compare_offset": { "type": "integer", "minimum": 0, "default": 0, "description": "Offset for the second scope in a selected group." },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "workspace" } } },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "organization_id"],
              "properties": { "kind": { "const": "organization" }, "organization_id": { "type": "string" } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "user_id"],
              "properties": { "kind": { "const": "user" }, "organization_id": { "type": ["string", "null"] }, "user_id": { "type": "string" } }
            }
          ]
        },
        "thread": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["trace_source", "conversation_id"],
          "description": "Match the full recorded thread identity. An omitted owner field matches a run without that owner.",
          "properties": {
            "trace_source": { "type": "string" }, "conversation_id": { "type": "string" },
            "organization_id": { "type": ["string", "null"] }, "user_id": { "type": ["string", "null"] }
          }
        },
        "after": { "type": ["string", "null"], "format": "date-time", "description": "Inclusive recorded call start. A time filter excludes calls with unknown dates." },
        "before": { "type": ["string", "null"], "format": "date-time", "description": "Exclusive recorded call start. A time filter excludes calls with unknown dates." }
      }
    }
  }
}
