{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2Context conflict view",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "group_by"],
  "properties": {
    "version": { "const": 1 },
    "phase": {
      "description": "Count recorded decisions or verified preflight checks. A preflight check is one rule scope on one request.",
      "enum": ["decision", "preflight"],
      "default": "decision"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "workspace" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "organization_id"],
          "properties": {
            "kind": { "const": "organization" },
            "organization_id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "user_id"],
          "properties": {
            "kind": { "const": "user" },
            "organization_id": { "type": ["string", "null"] },
            "user_id": { "type": "string" }
          }
        }
      ]
    },
    "group_by": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["organization", "user", "conversation", "model", "source_version", "rule", "day", "trace_source"]
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule": { "type": ["string", "null"] },
        "after": { "type": ["string", "null"], "format": "date-time" },
        "before": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "group": {
      "description": "Copy a key from the groups response to fetch the decisions or preflight checks that contribute to it.",
      "type": ["array", "null"],
      "items": {
        "type": "array",
        "items": { "type": ["string", "null"] }
      }
    },
    "offset": { "type": "integer", "minimum": 0, "default": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
  }
}
