{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexusWeave source visibility query",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "location", "report_id"],
  "properties": {
    "version": { "const": 1 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "call_id", "decision_id"],
      "properties": {
        "run_id": { "type": "string" },
        "call_id": { "type": "string" },
        "decision_id": { "type": "string" }
      }
    },
    "report_id": { "type": "string", "description": "Select a source visibility report from get_turn_evidence." },
    "view": {
      "default": { "kind": "timeline" },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "timeline" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "output_token"],
          "properties": {
            "kind": { "const": "sources" },
            "output_token": { "type": "integer", "minimum": 0, "description": "Zero-based recorded output token index." },
            "context_id": { "type": "string", "description": "Read one exact captured source by ID." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "output_token"],
          "properties": {
            "kind": { "const": "pairs" },
            "output_token": { "type": "integer", "minimum": 0, "description": "Zero-based recorded output token index." },
            "context_ids": {
              "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
              "items": { "type": "string" },
              "description": "Read one exact measured pair, in either source order."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "continuations" },
            "output_token": { "type": "integer", "minimum": 0, "description": "Filter by the zero-based output token where decoding resumes." },
            "context_ids": {
              "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
              "items": { "type": "string" },
              "description": "Match one exact source or pair, in either source order."
            }
          }
        }
      ]
    },
    "offset": { "type": "integer", "minimum": 0, "default": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 24, "default": 12 },
    "include_excerpts": { "type": "boolean", "default": false, "description": "Include token fragments or generated text when the host enables excerpts." }
  }
}
