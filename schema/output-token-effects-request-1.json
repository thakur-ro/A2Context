{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2Context output token effects request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "location", "report_id", "block"],
  "properties": {
    "version": {"const": 1},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "call_id", "decision_id"],
      "properties": {
        "run_id": {"type": "string"},
        "call_id": {"type": "string"},
        "decision_id": {"type": "string"}
      }
    },
    "report_id": {"type": "string"},
    "block": {"type": "integer", "minimum": 0, "description": "Zero-based decoder block."},
    "offset": {"type": "integer", "minimum": 0, "default": 0, "description": "Zero-based first output token."},
    "limit": {"type": "integer", "minimum": 1, "maximum": 24, "default": 12},
    "include_excerpts": {
      "type": "boolean",
      "default": false,
      "description": "Include bounded token fragments and token IDs when the process has enabled excerpts."
    },
    "include_edits": {
      "type": "boolean",
      "default": false,
      "description": "Include bounded original and edited source and generation excerpts, per-source peaks, and a repeated token comparison."
    }
  },
  "if": {"properties": {"include_edits": {"const": true}}, "required": ["include_edits"]},
  "then": {"properties": {"include_excerpts": {"const": true}}, "required": ["include_excerpts"]}
}
