      "text_range": {
        "start_byte": 0,
        "end_byte": 20
      },
      "replacement": "Request type: price."
    },
    {
      "context_id": "request-source:store-name",
      "pointer": "/messages/3/content",
      "operation": "replace_text_fragment",
      "text_range": {
        "start_byte": 0,
        "end_byte": 40
      },
      "replacement": "Background: the store’s name is Rowan."
    }
  ],
  "test_pair": true,
  "negative_control_context_id": "request-source:store-name"
}
