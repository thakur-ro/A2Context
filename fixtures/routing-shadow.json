{
  "version": 1,
  "id": "pending-product-route-shadow",
  "runner_id": "synthetic-routing-runner",
  "expected": {
    "kind": "tool_call",
    "label": "price",
    "outcome": {
      "product_id": 42
    }
  },
  "match_rule": {
    "kind": "outcome_fields",
    "pointers": [
      "/product_id"
    ]
  },
  "samples": 1,
  "interventions": [
    {
      "context_id": "request-source:request-type",
      "pointer": "/messages/1/content",
